{
  "openapi": "3.0.3",
  "info": {
    "title": "Amrutam Telemedicine Backend API",
    "version": "1.0.0",
    "description": "Production-grade RESTful API for Amrutam Telemedicine and Ayurvedic Healthcare System. Supports patient-doctor appointments, atomic concurrency-safe bookings, consultation lifecycle, Ayurvedic prescriptions, role-based authorization (RBAC), and admin analytics.",
    "contact": {
      "name": "Amrutam Engineering Team",
      "url": "https://amrutam.co.in"
    }
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Enter your JWT token obtained from /api/v1/auth/login or registration."
      }
    },
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "statusCode": {
            "type": "integer",
            "example": 200
          },
          "message": {
            "type": "string",
            "example": "Operation completed successfully"
          },
          "data": {
            "type": "object"
          }
        }
      },
      "ApiErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "statusCode": {
            "type": "integer",
            "example": 400
          },
          "message": {
            "type": "string",
            "example": "Error description"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "example": "email"
                },
                "message": {
                  "type": "string",
                  "example": "Invalid email address format"
                }
              }
            }
          }
        }
      },
      "RegisterPatientRequest": {
        "type": "object",
        "required": [
          "email",
          "password",
          "firstName",
          "lastName"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "aarav.sharma@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "example": "Password@123"
          },
          "firstName": {
            "type": "string",
            "example": "Aarav"
          },
          "lastName": {
            "type": "string",
            "example": "Sharma"
          },
          "gender": {
            "type": "string",
            "enum": [
              "MALE",
              "FEMALE",
              "OTHER"
            ],
            "example": "MALE"
          },
          "phoneNumber": {
            "type": "string",
            "example": "+919876543210"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date",
            "example": "1995-06-15"
          }
        }
      },
      "RegisterDoctorRequest": {
        "type": "object",
        "required": [
          "email",
          "password",
          "firstName",
          "lastName",
          "specialization",
          "qualification",
          "licenseNumber"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "dr.priya.nair@amrutam.co.in"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "example": "Password@123"
          },
          "firstName": {
            "type": "string",
            "example": "Priya"
          },
          "lastName": {
            "type": "string",
            "example": "Nair"
          },
          "specialization": {
            "type": "string",
            "example": "Ayurvedic Medicine & Panchakarma"
          },
          "qualification": {
            "type": "string",
            "example": "BAMS, MD (Ayurveda)"
          },
          "experienceYears": {
            "type": "integer",
            "example": 9
          },
          "licenseNumber": {
            "type": "string",
            "example": "AYUR-DL-98234"
          },
          "consultationFee": {
            "type": "number",
            "example": 750
          },
          "bio": {
            "type": "string",
            "example": "Senior Ayurvedic physician specializing in lifestyle disorders."
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "aarav.sharma@example.com"
          },
          "password": {
            "type": "string",
            "example": "Password@123"
          }
        }
      },
      "CreateSlotRequest": {
        "type": "object",
        "required": [
          "startTime",
          "endTime"
        ],
        "properties": {
          "startTime": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-22T09:00:00.000Z"
          },
          "endTime": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-22T10:00:00.000Z"
          }
        }
      },
      "CreateBookingRequest": {
        "type": "object",
        "required": [
          "slotId"
        ],
        "properties": {
          "slotId": {
            "type": "string",
            "format": "uuid",
            "example": "58c89599-528f-43ea-a42e-be25585f67b5"
          },
          "consultationType": {
            "type": "string",
            "enum": [
              "VIDEO",
              "AUDIO",
              "CHAT"
            ],
            "default": "VIDEO"
          },
          "symptomsSummary": {
            "type": "string",
            "example": "Chronic acidity, joint pain, and sluggish digestion."
          },
          "idempotencyKey": {
            "type": "string",
            "example": "idemp-client-unique-key-1234"
          }
        }
      },
      "CancelBookingRequest": {
        "type": "object",
        "required": [
          "cancellationReason"
        ],
        "properties": {
          "cancellationReason": {
            "type": "string",
            "minLength": 3,
            "example": "Sudden schedule conflict. Rescheduling."
          }
        }
      },
      "UpdateStatusRequest": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "CONFIRMED",
              "IN_PROGRESS",
              "COMPLETED",
              "CANCELLED",
              "RESCHEDULED"
            ],
            "example": "IN_PROGRESS"
          },
          "notes": {
            "type": "string",
            "example": "Patient admitted into video consultation."
          }
        }
      },
      "PrescriptionItemInput": {
        "type": "object",
        "required": [
          "medicineName",
          "dosage",
          "frequency",
          "duration"
        ],
        "properties": {
          "medicineName": {
            "type": "string",
            "example": "Ashwagandha Churna"
          },
          "dosage": {
            "type": "string",
            "example": "1 teaspoon (3g)"
          },
          "frequency": {
            "type": "string",
            "example": "Twice daily after meals"
          },
          "duration": {
            "type": "string",
            "example": "30 days"
          },
          "instructions": {
            "type": "string",
            "example": "Consume with warm milk or lukewarm water"
          }
        }
      },
      "CreatePrescriptionRequest": {
        "type": "object",
        "required": [
          "consultationId",
          "diagnosis",
          "items"
        ],
        "properties": {
          "consultationId": {
            "type": "string",
            "format": "uuid",
            "example": "49a8812c-bba8-4c6d-8809-ec199cc43f94"
          },
          "diagnosis": {
            "type": "string",
            "example": "Vata-Pitta imbalance with Agnimandya"
          },
          "notes": {
            "type": "string",
            "example": "Follow Sattvic diet. Avoid cold and fermented foods."
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PrescriptionItemInput"
            }
          }
        }
      },
      "VerifyDoctorRequest": {
        "type": "object",
        "required": [
          "isVerified"
        ],
        "properties": {
          "isVerified": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "UserStatusRequest": {
        "type": "object",
        "required": [
          "isActive"
        ],
        "properties": {
          "isActive": {
            "type": "boolean",
            "example": false
          }
        }
      },
      "ProcessPaymentRequest": {
        "type": "object",
        "required": [
          "consultationId"
        ],
        "properties": {
          "consultationId": {
            "type": "string",
            "format": "uuid",
            "example": "49a8812c-bba8-4c6d-8809-ec199cc43f94"
          },
          "paymentMethod": {
            "type": "string",
            "enum": [
              "UPI",
              "CARD",
              "NET_BANKING",
              "WALLET"
            ],
            "default": "UPI",
            "example": "UPI"
          },
          "idempotencyKey": {
            "type": "string",
            "example": "idemp-pay-992384"
          }
        }
      },
      "RefundPaymentRequest": {
        "type": "object",
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 5,
            "example": "Patient requested cancellation prior to consultation window."
          }
        }
      }
    }
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Root Welcome Endpoint",
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "Returns API welcome status and links",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "summary": "System Health Check & Database Diagnostic",
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "System operational status and live PostgreSQL ping latency",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/register/patient": {
      "post": {
        "summary": "Register a Patient Account",
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterPatientRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Patient registered successfully; returns JWT token"
          },
          "400": {
            "description": "Validation error (e.g. password too short)"
          },
          "409": {
            "description": "Email or phone number already registered"
          }
        }
      }
    },
    "/api/v1/auth/register/doctor": {
      "post": {
        "summary": "Register a Doctor Account (Pending verification)",
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDoctorRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Doctor registered successfully; pending verification"
          },
          "400": {
            "description": "Validation error"
          },
          "409": {
            "description": "Email, phone, or license number already exists"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "summary": "Authenticate User & Obtain JWT Token",
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful with JWT Bearer token"
          },
          "401": {
            "description": "Invalid email or password"
          },
          "403": {
            "description": "Account deactivated"
          },
          "429": {
            "description": "Too many authentication attempts (Rate limit exceeded)"
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "summary": "Get Current Authenticated User Profile",
        "tags": [
          "Authentication"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "User profile retrieved successfully"
          },
          "401": {
            "description": "Missing, invalid, or expired JWT token"
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "summary": "Logout & Invalidate JWT Token (Redis Blacklist)",
        "tags": [
          "Authentication"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully logged out; token added to Redis blacklist"
          },
          "401": {
            "description": "Missing or invalid authentication token"
          }
        }
      }
    },
    "/api/v1/doctors": {
      "get": {
        "summary": "Search & Filter Doctors",
        "tags": [
          "Doctors"
        ],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Free-text search across name & specialization"
          },
          {
            "name": "specialization",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Ayurvedic specialization filter"
          },
          {
            "name": "minFee",
            "in": "query",
            "schema": {
              "type": "number"
            },
            "description": "Minimum consultation fee"
          },
          {
            "name": "maxFee",
            "in": "query",
            "schema": {
              "type": "number"
            },
            "description": "Maximum consultation fee"
          },
          {
            "name": "minExperience",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Minimum years of experience"
          },
          {
            "name": "isVerified",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "Filter verified doctors"
          },
          {
            "name": "sortBy",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "experienceYears",
                "consultationFee",
                "createdAt",
                "firstName"
              ]
            }
          },
          {
            "name": "sortOrder",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of doctors with matching criteria"
          }
        }
      }
    },
    "/api/v1/doctors/{id}": {
      "get": {
        "summary": "Get Detailed Doctor Profile & Open Slots",
        "tags": [
          "Doctors"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Doctor profile and upcoming availability slots"
          },
          "404": {
            "description": "Doctor not found"
          }
        }
      }
    },
    "/api/v1/doctors/slots": {
      "post": {
        "summary": "Create Availability Slot(s) for Doctor",
        "tags": [
          "Doctors"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/CreateSlotRequest"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "slots": {
                        "type": "array",
                        "items": {
                          "$ref": "#/components/schemas/CreateSlotRequest"
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Availability slot(s) created successfully"
          },
          "400": {
            "description": "End time before start time or slot in the past"
          },
          "403": {
            "description": "Forbidden (DOCTOR role required)"
          },
          "409": {
            "description": "Overlapping slot already exists for doctor"
          }
        }
      }
    },
    "/api/v1/doctors/{id}/slots": {
      "get": {
        "summary": "Get Availability Slots for a Specific Doctor",
        "tags": [
          "Doctors"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "isBooked",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "Filter by booked status (false for open slots)"
          },
          {
            "name": "startDate",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "endDate",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Availability slots for doctor"
          },
          "404": {
            "description": "Doctor not found"
          }
        }
      }
    },
    "/api/v1/doctors/slots/{slotId}": {
      "delete": {
        "summary": "Delete Unbooked Availability Slot",
        "tags": [
          "Doctors"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "slotId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Slot deleted successfully"
          },
          "400": {
            "description": "Cannot delete a slot that is already booked"
          },
          "403": {
            "description": "Forbidden (Can only delete own slot)"
          },
          "404": {
            "description": "Slot not found"
          }
        }
      }
    },
    "/api/v1/bookings": {
      "post": {
        "summary": "Book an Appointment (Concurrency-Safe with Idempotency)",
        "tags": [
          "Bookings"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Optional unique client key. Prevents duplicate booking on network retry."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBookingRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Idempotent replay: returns existing booking"
          },
          "201": {
            "description": "Appointment booked successfully with meeting link"
          },
          "400": {
            "description": "Slot in the past"
          },
          "403": {
            "description": "Forbidden (PATIENT role required)"
          },
          "409": {
            "description": "Conflict: Slot already booked by another user"
          }
        }
      },
      "get": {
        "summary": "List Appointments for Authenticated User",
        "tags": [
          "Bookings"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "PENDING",
                "CONFIRMED",
                "IN_PROGRESS",
                "COMPLETED",
                "CANCELLED",
                "RESCHEDULED"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated appointments for current patient or doctor"
          }
        }
      }
    },
    "/api/v1/bookings/{id}": {
      "get": {
        "summary": "Get Appointment Details by ID",
        "tags": [
          "Bookings"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Booking details with doctor and slot info"
          },
          "403": {
            "description": "Forbidden (Can only view own booking)"
          },
          "404": {
            "description": "Booking not found"
          }
        }
      }
    },
    "/api/v1/bookings/{id}/cancel": {
      "patch": {
        "summary": "Cancel an Appointment (Frees the Slot Atomically)",
        "tags": [
          "Bookings"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelBookingRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Appointment cancelled successfully; slot freed"
          },
          "400": {
            "description": "Cannot cancel a COMPLETED or CANCELLED booking"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Booking not found"
          }
        }
      }
    },
    "/api/v1/bookings/{id}/status": {
      "patch": {
        "summary": "Update Consultation Lifecycle Status (Doctor or Admin)",
        "tags": [
          "Bookings"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateStatusRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Status updated successfully"
          },
          "400": {
