# ==============================================
# AMRUTAM TELEMEDICINE BACKEND - ENVIRONMENT CONFIG
# ==============================================

# Server Configuration
NODE_ENV=development
PORT=5000

# PostgreSQL Database Connection URL (Prisma)
# Format: postgresql://<USERNAME>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/amrutam_telemedicine?schema=public"

# CORS Origin Allowed (e.g., http://localhost:3000 or * for development)
CORS_ORIGIN=*

# JWT Authentication Secrets (For upcoming auth modules)
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Redis Cache & Token Blacklist Service
REDIS_URL=redis://localhost:6379
